# Copy this file to a local .env only if your launcher loads it.
# SpecFlow itself reads these values from the process environment.

SPECFLOW_LLM_BASE_URL=
SPECFLOW_LLM_API_KEY=
SPECFLOW_LLM_MODEL=
SPECFLOW_LLM_TIMEOUT_SECONDS=60

# Optional HTTP API hardening (localhost single-user by default).
# SPECFLOW_API_KEY=                          # require this key on /api/v1 requests
# SPECFLOW_ALLOWED_REPOSITORY_ROOTS=         # semicolon-separated roots
# SPECFLOW_REVIEWER_LABELS=                  # comma-separated approved labels
# SPECFLOW_MAX_RUNS_PER_MINUTE=30
# SPECFLOW_MAX_CONCURRENT_RUNS=1
